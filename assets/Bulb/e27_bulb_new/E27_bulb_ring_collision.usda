#usda 1.0
(
    defaultPrim = "E27_Bulb"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "E27_Bulb" (
    prepend references = @./E27_bulb_rigid.usda@</E27_Bulb>
)
{
    def Xform "thread_collision"
    {
        def Cylinder "thread_ring_0" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double height = 0.002
            double radius = 0.0125
            uniform token axis = "Z"
            bool physics:collisionEnabled = 1
            double3 xformOp:translate = (0, 0, -0.051)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cylinder "thread_ring_1" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double height = 0.002
            double radius = 0.0125
            uniform token axis = "Z"
            bool physics:collisionEnabled = 1
            double3 xformOp:translate = (0, 0, -0.044)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cylinder "thread_ring_2" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double height = 0.002
            double radius = 0.0125
            uniform token axis = "Z"
            bool physics:collisionEnabled = 1
            double3 xformOp:translate = (0, 0, -0.037)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

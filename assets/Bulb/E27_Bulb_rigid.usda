#usda 1.0
(
    defaultPrim = "E27_Bulb"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "E27_Bulb" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    bool physics:kinematicEnabled = 0
    bool physics:rigidBodyEnabled = 1
    float physics:mass = 0.065

    def Xform "visual" (
        prepend references = @./E27_Bulb.usdz@
    )
    {
        uniform token visibility = "inherited"

        # The source USDZ is Y-up and authored in oversized centimeter units.
        # Normalize it to a 109 mm tall, Z-up bulb matching this meter-based stage.
        double3 xformOp:translate = (0, 0, -0.004771492844696)
        float xformOp:rotateX = 90
        double3 xformOp:scale = (0.000363333334387, 0.000363333334387, 0.000363333334387)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX", "xformOp:scale"]

        # Reuse each referenced visual mesh as a convex collision source. Keeping
        # the opinions in this wrapper avoids modifying or repacking the USDZ.
        over "Meshes"
        {
            over "Sketchfab_model"
            {
                over "_435da0c11484780a987912ee66bff77_fbx"
                {
                    over "RootNode"
                    {
                        over "Bulb"
                        {
                            over "Bulb_Inox_0"
                            {
                                over "Bulb_Inox_0" (
                                    prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                                )
                                {
                                    uniform token physics:approximation = "convexHull"
                                    bool physics:collisionEnabled = 1
                                }
                            }

                            over "Bulb_White_0"
                            {
                                over "Bulb_White_0" (
                                    prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                                )
                                {
                                    uniform token physics:approximation = "convexHull"
                                    bool physics:collisionEnabled = 1
                                }
                            }

                            over "Bulb_Led_0"
                            {
                                over "Bulb_Led_0" (
                                    prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                                )
                                {
                                    uniform token physics:approximation = "convexHull"
                                    bool physics:collisionEnabled = 1
                                }
                            }

                            over "Base"
                            {
                                over "Base_Inox_0"
                                {
                                    over "Base_Inox_0" (
                                        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                                    )
                                    {
                                        uniform token physics:approximation = "convexHull"
                                        bool physics:collisionEnabled = 1
                                    }
                                }

                                over "Base_White_0"
                                {
                                    over "Base_White_0" (
                                        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                                    )
                                    {
                                        uniform token physics:approximation = "convexHull"
                                        bool physics:collisionEnabled = 1
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    def Scope "Looks"
    {
        def Material "warm_frosted_glass"
        {
            token outputs:surface.connect = </E27_Bulb/Looks/warm_frosted_glass/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1.0, 0.86, 0.58)
                float inputs:opacity = 1.0
                float inputs:roughness = 0.72
                float inputs:metallic = 0.0
                token outputs:surface
            }
        }

        def Material "brushed_aluminum"
        {
            token outputs:surface.connect = </E27_Bulb/Looks/brushed_aluminum/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.62, 0.58)
                float inputs:roughness = 0.38
                float inputs:metallic = 0.85
                token outputs:surface
            }
        }
    }

    def Xform "thread_visual" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </E27_Bulb/Looks/brushed_aluminum>

        def Cylinder "thread_ring_0"
        {
            double height = 0.002
            double radius = 0.0145
            uniform token axis = "Z"
            double3 xformOp:translate = (0, 0, -0.041)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cylinder "thread_ring_1"
        {
            double height = 0.002
            double radius = 0.0145
            uniform token axis = "Z"
            double3 xformOp:translate = (0, 0, -0.046)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cylinder "thread_ring_2"
        {
            double height = 0.002
            double radius = 0.0145
            uniform token axis = "Z"
            double3 xformOp:translate = (0, 0, -0.051)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

}
